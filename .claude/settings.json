{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pytest:*)",
      "Bash(python -m pytest:*)",
      "Bash(ruff check:*)",
      "Bash(ruff format:*)",
      "Bash(job-scout check:*)",
      "Bash(job-scout version)",
      "Bash(job-scout init:*)",
      "Bash(job-scout run --dry-run:*)",
      "Bash(python -m job_scout check:*)",
      "Bash(python -m job_scout run --dry-run:*)",
      "Bash(pip install -e .:*)",
      "Bash(pip list:*)",
      "Bash(python --version)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(job-scout stats:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Read(//**)",
      "Edit(./job_scout/**)",
      "Edit(./tests/**)",
      "Edit(./docs/**)",
      "Edit(./examples/**)",
      "Edit(./deploy/**)",
      "Edit(./.claude/**)",
      "Edit(./README.md)",
      "Edit(./AGENTS.md)",
      "Edit(./CONTRIBUTING.md)",
      "Edit(./config.yaml)",
      "Edit(./profile.yaml)",
      "WebFetch(domain:docs.apify.com)",
      "WebFetch(domain:apify.com)",
      "WebFetch(domain:ai.google.dev)",
      "WebFetch(domain:openrouter.ai)",
      "WebFetch(domain:core.telegram.org)",
      "WebFetch(domain:www.careerjet.com)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Edit(./.env)",
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(gh repo create:*)",
      "Bash(gh release:*)",
      "Bash(job-scout run)",
      "Bash(python -m job_scout run)"
    ]
  }
}
