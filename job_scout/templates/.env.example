# .env — every secret the scout uses. Copy this file to .env and fill in what
# you actually need. .env is in .gitignore; never commit it.
#
# You do NOT need all of this. For a first run you need exactly one line:
# GOOGLE_API_KEY. Everything else is for a source or a notifier you have chosen
# to turn on.
#
# Run `job-scout check` at any point to see what is set and what is missing.

# ─── Scoring: pick one ────────────────────────────────────────────────────────

# Google AI Studio. Free tier, no card required, and enough daily quota for a
# once-a-day run. Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# OpenRouter, if you would rather route through them. https://openrouter.ai/keys
# OPENROUTER_API_KEY=

# The claude / grok / codex backends need no key here — they use the CLI you
# already have logged in. If the CLI lives on another machine, point at it:
# LLM_CLI_SSH_HOST=user@vm.example.com
# LLM_CLI_SSH_KEY=/home/you/.ssh/id_ed25519
# LLM_CLI_TIMEOUT=600

# ─── Notifiers: at least one ──────────────────────────────────────────────────

# Telegram. Create a bot with @BotFather, message it once, then read your chat
# id from https://api.telegram.org/bot<TOKEN>/getUpdates
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Email over SMTP. On Gmail this must be an App Password, not your account
# password: https://myaccount.google.com/apppasswords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_SECURITY=starttls

# Slack or Discord incoming webhook. Treat the URL as a password.
# WEBHOOK_URL=

# The `file` notifier needs nothing here. That is why it is the default.

# ─── Optional job sources ─────────────────────────────────────────────────────

# Careerjet partner API — https://www.careerjet.com/partners/api
# All three are required together. Careerjet rejects calls whose referring site
# and IP do not match the ones you registered when you signed up.
# CAREERJET_API_KEY=
# CAREERJET_REFERER=https://example.com/jobs
# CAREERJET_USER_IP=203.0.113.10

# Apify — paid, and the fix for LinkedIn and Indeed throttling datacenter IPs.
# Token from https://console.apify.com/settings/integrations
# APIFY_API_TOKEN=

# ─── Paths (optional) ─────────────────────────────────────────────────────────

# Keep your config.yaml and profile.yaml outside this repository.
# JOB_SCOUT_CONFIG_DIR=/home/you/job-search
# JOB_SCOUT_DATA_DIR=/var/lib/job-scout
